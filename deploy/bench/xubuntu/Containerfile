# Bureau Xubuntu 24.04 pour le banc PoolSync : Xorg (pilote dummy) + XFCE4,
# vue web via noVNC (x11vnc), ssh, et les outils de pilotage (xdotool, xclip).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive LANG=fr_FR.UTF-8 LC_ALL=fr_FR.UTF-8
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    xubuntu-core xfce4-terminal xfce4-screenshooter mousepad \
    xserver-xorg-core xserver-xorg-video-dummy xinit x11-xserver-utils xauth \
    x11vnc novnc websockify supervisor openssh-server sudo locales \
    xdotool xclip python3-gi gir1.2-gtk-3.0 libnotify-bin libayatana-appindicator3-1 \
    fonts-dejavu ca-certificates curl \
 && sed -i 's/^# *fr_FR.UTF-8/fr_FR.UTF-8/' /etc/locale.gen && locale-gen >/dev/null \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash zaza && echo 'zaza ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/zaza \
 && mkdir -p /run/sshd /data /var/log/desk /tmp/runtime-zaza && chown zaza:zaza /tmp/runtime-zaza
COPY xorg-dummy.conf /etc/X11/xorg.conf
COPY supervisord.conf /etc/supervisor/conf.d/desk.conf
COPY entry.sh /usr/local/bin/entry.sh
RUN chmod +x /usr/local/bin/entry.sh
EXPOSE 22 6080
CMD ["/usr/local/bin/entry.sh"]
