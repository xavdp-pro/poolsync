[Desktop Entry]
Type=Application
Name=PoolSync Agent
Comment=Démarre PoolSync à la connexion XFCE
Exec=/bin/sh -c 'export XDG_RUNTIME_DIR=/run/user/$(id -u); systemctl --user start poolsync-agent.service poolsync-watchdog.timer'
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-XFCE-Autostart-Trigger=on
