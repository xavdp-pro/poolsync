# Secrets de déploiement PoolSync — copier en `.env` (jamais versionné).
#
#   cp .env.example .env && $EDITOR .env
#
# Le token est le secret partagé qui authentifie les agents auprès du hub :
# quiconque le détient et joint le hub peut lire tout ce que le pool copie.
# Le générer avec :  openssl rand -hex 16
POOLSYNC_TOKEN=

# Facultatif — surcharge l'adresse du hub pour deploy/test-clipboard.sh
# HUB_HTTP=http://10.87.78.22:9470
# HUB_WS=ws://10.87.78.22:9470/ws
