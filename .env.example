# Secrets de déploiement PoolSync — copier en `.env` (jamais versionné).
#
#   cp .env.example .env && $EDITOR .env
#
# Jeton administrateur du dashboard et des API HTTP. Les agents utilisent leur
# node_token lorsque POOLSYNC_SECURITY_DIR est fourni aux installateurs.
POOLSYNC_TOKEN=

# Répertoire créé par deploy/generate-security.sh. Sa présence active TLS,
# identités par nœud et E2E dans install-hub-gbs-p3.sh/install-agent*.sh.
# POOLSYNC_SECURITY_DIR=/chemin/hors-depot/poolsync-security

# Après migration complète, le hub refuse les presse-papiers en clair.
# POOLSYNC_REQUIRE_E2E=true

# Facultatif — surcharge l'adresse du hub pour deploy/test-clipboard.sh
# HUB_HTTP=https://hub.example:9470
# HUB_WS=wss://hub.example:9470/ws
